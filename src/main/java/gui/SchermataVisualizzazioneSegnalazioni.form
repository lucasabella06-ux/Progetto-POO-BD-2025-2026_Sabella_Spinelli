<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.SchermataVisualizzazioneSegnalazioni">
  <grid id="27dc6" binding="panelVisualizzazioneSegnalazioni" layout-manager="GridLayoutManager" row-count="4" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties>
      <background color="-2544609"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="edeb0" class="javax.swing.JLabel" binding="labelGiocatoreSelezionato">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="DialogInput" size="18" style="3"/>
          <text value="Segnalazioni ricevute da "/>
        </properties>
      </component>
      <scrollpane id="8d575" binding="pannelloSegnalazioni">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="a672e" class="javax.swing.JTable" binding="tabellaSegnalazioni">
            <constraints/>
            <properties>
              <background color="-459265"/>
              <foreground color="-2544609"/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <component id="aeb1c" class="javax.swing.JButton" binding="indietroButton">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-5197101"/>
          <foreground color="-2544609"/>
          <horizontalAlignment value="0"/>
          <text value="🔙"/>
        </properties>
      </component>
      <component id="4797c" class="javax.swing.JButton" binding="bandisciGiocatoreButton" default-binding="true">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-16185080"/>
          <font name="Fira Code" size="16" style="1"/>
          <foreground color="-58332"/>
          <text value="Bandisci Giocatore"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
